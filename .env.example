# =============================================================================
#  .env.example - variaveis da stack local de laboratorio
#
#  Uso (opcional): copie para .env e ajuste apenas o que precisar.
#      cp .env.example .env
#
#  A stack funciona SEM nenhum .env: todos os valores abaixo sao os proprios
#  defaults embutidos no docker-compose.yml. Este arquivo existe para:
#    1. documentar as variaveis disponiveis;
#    2. permitir trocar portas que ja estejam ocupadas no host.
#
#  IMPORTANTE: o arquivo .env esta no .gitignore e NAO deve ser versionado.
#  Nenhum segredo real, token do GitHub ou PAT deve ser colocado aqui.
# =============================================================================

# ----------------------------------------------------------------------------
# Portas publicadas no host
# Troque aqui se a porta sugerida estiver em uso na sua maquina.
# ----------------------------------------------------------------------------
APP_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAYLOG_PORT=9000
GELF_PORT=12201

# ----------------------------------------------------------------------------
# Credenciais do Grafana - DESENVOLVIMENTO / LABORATORIO LOCAL
# Valores default reprodutiveis, documentados no README.
# NAO reutilizar em producao.
# ----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# ----------------------------------------------------------------------------
# Credenciais do Graylog - DESENVOLVIMENTO / LABORATORIO LOCAL
#
# GRAYLOG_ROOT_PASSWORD_SHA2 e o SHA-256 da senha em texto puro. O valor abaixo
# corresponde a senha "admin" e pode ser regerado com:
#
#     echo -n 'suaSenha' | sha256sum
#
# GRAYLOG_ADMIN_PASSWORD e a mesma senha em texto puro, usada pelo servico
# graylog-init para autenticar na API e criar o Input GELF.
#
# GRAYLOG_PASSWORD_SECRET precisa ter no minimo 16 caracteres.
# NAO reutilizar nenhum destes valores em producao.
# ----------------------------------------------------------------------------
GRAYLOG_ADMIN_PASSWORD=admin
GRAYLOG_ROOT_PASSWORD_SHA2=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918
GRAYLOG_PASSWORD_SECRET=devops-observability-lab-secret
